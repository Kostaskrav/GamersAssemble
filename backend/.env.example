# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gamersassemble?schema=public

# Local development only. Replace before deploying anywhere shared.
JWT_SECRET=local-dev-only-change-me
JWT_EXPIRES_IN=1h